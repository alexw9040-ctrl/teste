# Backend
APP_ENV=development
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=replace-in-secret-manager
POSTGRES_PASSWORD=defina-uma-senha-forte-para-o-banco
# true quando a API for servida por HTTPS (obrigatório por padrão em APP_ENV=production)
COOKIE_SECURE=false
DATABASE_URL=postgresql+psycopg://sigcem:sigcem@localhost:5432/sigcem
STORAGE_ROOT=./storage
BACKUP_ROOT=./backups
ALLOWED_ORIGINS=http://localhost:3000
AUTO_CREATE_TABLES=true

# Seed administrativo: obrigatórios apenas ao criar o primeiro usuário
SIGCEM_ADMIN_EMAIL=admin@example.gov.br
SIGCEM_ADMIN_NAME=Administrador SIGCEM
SIGCEM_ADMIN_PASSWORD=defina-uma-senha-forte-aqui

# Frontend
VITE_API_BASE_URL=http://localhost:8000
